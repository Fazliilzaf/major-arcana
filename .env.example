ARCANA_MARKETING_AUTO_PUBLISH_PILOT_CHANNELS=linkedin
ARCANA_MARKETING_PUBLISH_PILOT_MAX_RISK_LEVEL=3

# CCO patient migration — Drive utan zip
# Alternativ A: Google Drive API (rekommenderat, ingen lokal nedladdning)
ARCANA_GOOGLE_DRIVE_FOLDER_ID=
ARCANA_GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternativ B: lokal mirror via Google Drive for Desktop (mapp utanför iCloud)
ARCANA_DRIVE_MIRROR_ROOT=
# Cliento CSV + migration index
ARCANA_MIGRATION_ROOT=
ARCANA_MIGRATION_INDEX_PATH=
# Prod verify migration (OWNER)
# ARCANA_OWNER_TOKEN=

# Aisia DS-3 scalp analysis (FAS 0+1 MVP — isolated, off by default)
# Set true only after owner says "APPLY AISIA TO CCO"
ENABLE_AISIA_SCALP_ANALYSIS=false

# Photo Review Fas 2 — single-asset decisions (dev/staging only; blocked on prod hosts)
# Cycle 15 — operator canary (max 25 decisions per track)
ENABLE_CCO_OPERATOR_CANARY=false
ENABLE_PHOTO_REVIEW_WRITE=false
ENABLE_PHOTO_REVIEW_CANARY_ON_PROD=false
PHOTO_REVIEW_CANARY_MAX_DECISIONS=25
ENABLE_IMPORT_REVIEW_WRITE=false
IMPORT_REVIEW_CANARY_MAX_DECISIONS=25
ENABLE_MAIL_REVIEW_CANARY=false
MAIL_REVIEW_CANARY_MAX_DECISIONS=25
# PHOTO_REVIEW_FULL_COHORT=true  # 150 patients / 861 photos — disables 5-patient pilot cap
# PHOTO_REVIEW_PILOT_PATIENT_IDS=cliento_xxx,cliento_yyy
PHOTO_REVIEW_PILOT_MAX_DECISIONS=20
PHOTO_REVIEW_PILOT_MAX_PATIENTS=5
# PHOTO_REVIEW_WRITE_BLOCKED_HOSTS=arcana-cco.onrender.com,arcana.hairtpclinic.com,arcana.hairtpclinic.se
