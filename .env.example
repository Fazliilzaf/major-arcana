# Knowledge base
KNOWLEDGE_DIR=./knowledge/hair-tp-clinic

# Cliento booking widget
# One or more account IDs (comma-separated). If you provide two IDs the widget will let the user choose company.
CLIENTO_ACCOUNT_IDS=
# Optional widget service filters (comma-separated or JSON array)
CLIENTO_SERVICE_FILTERS=
# Optional fallback: open/iframe the public booking page (e.g. the Cliento "business" link)
CLIENTO_BOOKING_URL=
CLIENTO_WIDGET_SRC=https://cliento.com/widget-v2/cliento.js
CLIENTO_LOCALE=sv
CLIENTO_MERGE_LOCATIONS=false

# Optional Cliento REST API proxy configuration
CLIENTO_PARTNER_ID=
CLIENTO_API_BASE_URL=https://cliento.com/api/v2/partner/cliento
CLIENTO_API_KEY=
CLIENTO_API_AUTH_HEADER=Authorization
CLIENTO_API_AUTH_SCHEME=Bearer
CLIENTO_API_TIMEOUT_MS=10000

# Fortnox accounting integration (OAuth + patient customer sync)
ARCANA_FORTNOX_ENABLED=false
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
FORTNOX_SCOPE=customer invoice
# Defaults to ${PUBLIC_BASE_URL}/api/v1/cco-fortnox/oauth/callback when unset
FORTNOX_REDIRECT_URI=
# Optional override for OAuth token store (defaults under ARCANA_STATE_ROOT)
# ARCANA_CCO_FORTNOX_STORE_PATH=

# Swish Commerce integration (mTLS + payment requests)
ARCANA_SWISH_ENABLED=false
SWISH_API_BASE_URL=https://mss.cpc.getswish.net/swish-cpcapi
# Production: https://cpc.getswish.net/swish-cpcapi
SWISH_CERT_PATH=
SWISH_KEY_PATH=
# Or use a PKCS#12 bundle instead of PEM cert/key:
SWISH_P12_PATH=
SWISH_CERT_PASSPHRASE=
SWISH_CA_PATH=
# Defaults to ${PUBLIC_BASE_URL}/api/v1/cco-swish/callback when unset
SWISH_CALLBACK_URL=
# Optional override for payment store (defaults under ARCANA_STATE_ROOT)
# ARCANA_CCO_SWISH_STORE_PATH=

# Brand-specific overrides (recommended if you serve both Hair TP Clinic + Curatiio from the same server)
CLIENTO_ACCOUNT_IDS_HAIR_TP_CLINIC=4yPQXQy6WMgoZnCAOylVjx
CLIENTO_SERVICE_FILTERS_HAIR_TP_CLINIC=Hair TP Clinic
CLIENTO_BOOKING_URL_HAIR_TP_CLINIC=https://cliento.com/business/hair-tp-clinic-1650/
CLIENTO_WIDGET_SRC_HAIR_TP_CLINIC=https://cliento.com/widget-v3/cliento.js
CLIENTO_PARTNER_ID_HAIR_TP_CLINIC=4yPQXQy6WMgoZnCAOylVjx

CLIENTO_ACCOUNT_IDS_CURATIIO=
CLIENTO_SERVICE_FILTERS_CURATIIO=
CLIENTO_BOOKING_URL_CURATIIO=
CLIENTO_WIDGET_SRC_CURATIIO=https://cliento.com/widget-v2/cliento.js

KNOWLEDGE_DIR_HAIR_TP_CLINIC=./knowledge/hair-tp-clinic
KNOWLEDGE_DIR_CURATIIO=./knowledge/curatiio

# CMO marketing connectors (Fas O — read-only metrics, no auto-publish)
