ARCANA_MARKETING_CONNECTORS_ENABLED=false
ARCANA_MARKETING_CONNECTORS_MODE=fixture
ARCANA_MARKETING_CONNECTORS_LIVE_FETCH=false
ARCANA_MARKETING_BRIDGE_TOKEN=
