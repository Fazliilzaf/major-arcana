    },
    {
      "id": "public_major_arcana_preview_cco_ops_workbench_v3_controlled_completion_canary",
      "label": "Controlled Completion Canaries (Cycle 16)",
      "file_type": "concept",
      "source_file": "public/major-arcana-preview/cco-ops-workbench-v3.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Max 25 beslut per sp\u00e5r, ett beslut i taget, full audit, noll massapproval och noll AI-auto \u2014 kontrollerad avslutning v\u00e4ljs framf\u00f6r snabb genomstr\u00f6mning f\u00f6r att fel ska uppt\u00e4ckas inom en liten m\u00e4ngd."
    },
    {
      "id": "public_major_arcana_preview_cco_ops_workbench_v3_owner_write_canary_gate",
      "label": "Owner-godk\u00e4nd write-canary (BLOCKER_C/D)",
