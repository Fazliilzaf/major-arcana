    {
      "id": "public_major_arcana_preview_cco_staff_go_live_v3_readiness_gates",
      "label": "Readiness-gates f\u00f6re pilotstart",
      "file_type": "concept",
      "source_file": "public/major-arcana-preview/cco-staff-go-live-v3.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Journalroute 200 p\u00e5 prod, Pre-Signering Check \u00f6ppen i sido-flik, Command Center bemannat och admin/ops n\u00e4ra f\u00f6r identitet/dubbletter \u2014 alla fyra m\u00e5ste vara gr\u00f6na innan f\u00f6rsta patienten, eftersom pilotens risk ligger i identitet och i tysta serverfel."
    },
    {
      "id": "public_major_arcana_preview_cco_staff_go_live_v3_role_split",
      "label": "Dag-1 rollf\u00f6rdelning",
      "file_type": "concept",
      "source_file": "public/major-arcana-preview/cco-staff-go-live-v3.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Personal journalf\u00f6r, operator/admin \u00e4ger review-k\u00f6er men skapar inga journaler, owner beslutar om stopp, revisor l\u00e4ser enbart CF utan att r\u00f6ra patientdata \u2014 rollgr\u00e4nser s\u00e4tts f\u00f6r att en granskningsroll aldrig ska kunna bli klinisk k\u00e4lla."
    },
    {
      "id": "public_major_arcana_preview_cco_staff_go_live_v3_stop_rules",
      "label": "Stoppregler f\u00f6r journalpiloten",
      "file_type": "concept",
      "source_file": "public/major-arcana-preview/cco-staff-go-live-v3.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Fel patient, signering p\u00e5 os\u00e4ker identitet, 5xx p\u00e5 journalroutes, patientdata i fel kundkort, review-material som klinisk sanning och extern AI p\u00e5 journaltext stoppar piloten direkt; tv\u00e5 oberoende personalrapporter om samma fel r\u00e4cker f\u00f6r paus."
    },
    {
      "id": "public_major_arcana_preview_cco_staff_go_live_v3_escalation_matrix",
      "label": "Eskaleringsmatris \u00b7 vem, vad, vad du s\u00e4ger",
      "file_type": "concept",
      "source_file": "public/major-arcana-preview/cco-staff-go-live-v3.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Matrisen kopplar problem till mottagare, dokumentationskrav och en f\u00e4rdig replik till patienten, s\u00e5 att personal slipper improvisera i stunden; identitets- och dubblettfr\u00e5gor g\u00e5r till admin/ops, incidenter direkt till owner."
    },
    {
      "id": "public_major_arcana_preview_cco_staff_go_live_v3_first_patient_block",
      "label": "F\u00f6rsta arbetsblock \u00b7 1\u20133 k\u00e4nda patienter",
      "file_type": "concept",
      "source_file": "public/major-arcana-preview/cco-staff-go-live-v3.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Kontrollerad start med k\u00e4nda, lugna patienter (inte f\u00f6rstag\u00e5ngsbes\u00f6k, inte komplicerad historik), f\u00f6ljt av feed/timeline-kontroll, r\u00e4ttelsetest och ops-avst\u00e4mning \u2014 30 sekunders efterkontroll per patient f\u00e5ngar bindningsfel tidigt."
    },
    {
      "id": "public_major_arcana_preview_cco_staff_go_live_v3_external_ai_ban",
      "label": "F\u00f6rbud mot extern AI p\u00e5 journaltext",
      "file_type": "concept",
      "source_file": "public/major-arcana-preview/cco-staff-go-live-v3.html",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Copy-paste av journaltext till externa AI-verktyg klassas som GDPR-incident och stoppregel \u2014 patientdata f\u00e5r aldrig l\u00e4mna systemet."
    }
  ],
